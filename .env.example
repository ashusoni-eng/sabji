# Copy to .env.local for development. On a server use .env.production instead —
# see DEPLOYMENT.md. Values are inlined at BUILD time, so a change here does
# nothing until you rebuild.

# Shop name shown in the header, the login screen and the PWA install prompt.
# Fixed for the whole app — it is not editable from the admin UI.
VITE_STORE_NAME=Suvidha General Store

# Supabase — create a free project at https://supabase.com, then copy these
# from Project Settings → API. The anon key is meant to be public; row-level
# security is what protects your data, not this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sign-in code, while SMS is not connected.
#
# The login screen accepts this code for any phone number instead of sending an
# SMS. Sign-in still goes through Supabase (anonymous auth), so the JWT, RLS and
# admin checks all behave exactly as they will in production; only the proof
# that you own the number is skipped. Requires Anonymous sign-ins = ON.
#
# Remove this once an SMS provider is connected in Supabase; the app then calls
# signInWithOtp automatically, with no code change.
VITE_DEV_STATIC_OTP=123456
